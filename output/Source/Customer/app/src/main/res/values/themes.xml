<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DeraShanwari" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorOnPrimary">@color/brand_white</item>
        <item name="colorPrimaryContainer">@color/brand_amber_soft</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="colorSurface">@color/card_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:navigationBarColor">@color/brand_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.DeraShanwari.Splash" parent="Theme.DeraShanwari">
        <item name="android:windowBackground">@drawable/bg_glass_canvas</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
