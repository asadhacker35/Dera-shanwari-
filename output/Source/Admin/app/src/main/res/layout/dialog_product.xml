<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="18dp">

        <ImageView
            android:id="@+id/iv_prod_preview"
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:background="@drawable/bg_glass_card"
            android:contentDescription="Product Photo Preview"
            android:scaleType="centerCrop"
            android:src="@drawable/img_banner_shanwari" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prod_camera"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="Camera"
                android:textColor="@color/admin_white"
                android:textSize="12sp"
                app:backgroundTint="@color/admin_orange"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prod_gallery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="Gallery"
                android:textColor="@color/admin_orange_dark"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/admin_orange" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_prod_remove_photo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Remove"
                android:textColor="@color/admin_danger"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:strokeColor="@color/admin_danger" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_prod_upload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_prod_upload_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap Camera or Gallery to upload via ImageKit"
            android:textColor="@color/admin_text_muted"
            android:textSize="11.5sp" />

        <EditText
            android:id="@+id/et_prod_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Product Name" />

        <EditText
            android:id="@+id/et_prod_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Description" />

        <EditText
            android:id="@+id/et_prod_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Base Price (Rs) — or add variants below"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/et_prod_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Base Discount Price (0 if none)"
            android:inputType="numberDecimal" />

        <Spinner
            android:id="@+id/spinner_prod_category"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card_orange"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Product Variants (Optional / Multi-Size)"
                    android:textColor="@color/admin_orange_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_variant"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="+ Add Variant"
                    android:textColor="@color/admin_white"
                    android:textSize="11.5sp"
                    app:backgroundTint="@color/admin_orange"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_prod_variants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_prod_available"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Available" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_prod_featured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Featured Dish" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_prod_popular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:text="Popular Dish" />
    </LinearLayout>
</ScrollView>
