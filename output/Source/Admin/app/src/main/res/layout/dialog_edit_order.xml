<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/et_edit_cust_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Customer Name"
        android:inputType="textPersonName"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_edit_cust_phone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:hint="Customer Phone"
        android:inputType="phone"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_edit_delivery_address"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:hint="Delivery Address"
        android:inputType="textPostalAddress"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_edit_notes"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:hint="Order Notes"
        android:inputType="textMultiLine"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_edit_delivery_fee"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:hint="Delivery Fee"
        android:inputType="numberDecimal"
        android:textSize="14sp" />
</LinearLayout>
