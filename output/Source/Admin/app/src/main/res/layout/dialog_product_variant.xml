<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <EditText
        android:id="@+id/et_variant_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Variant Name (e.g. Half 0.5 Kg, Full 1 Kg)" />

    <EditText
        android:id="@+id/et_variant_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Variant Price (Rs)"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/et_variant_discount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Discount Price (0 if none)"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/et_variant_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Optional serving note (e.g. Serves 2-3)" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_variant_available"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checked="true"
        android:text="Variant Available" />
</LinearLayout>
