<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_header"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Payments, Reports &amp; Settings"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_more_group_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Group Chat"
                    android:textColor="@color/admin_white"
                    android:textSize="12sp"
                    app:backgroundTint="@color/admin_orange"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_more_payments"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Payments"
                    android:textColor="@color/admin_white"
                    app:backgroundTint="@color/admin_orange"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_more_reports"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:text="Reports"
                    android:textColor="@color/admin_text_primary"
                    app:backgroundTint="@color/admin_surface_elevated"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_more_settings"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Settings"
                    android:textColor="@color/admin_text_primary"
                    app:backgroundTint="@color/admin_surface_elevated"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- PAYMENTS SECTION -->
        <LinearLayout
            android:id="@+id/section_payments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Methods Configuration"
                android:textColor="@color/admin_orange_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_payment_methods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Payment Records"
                android:textColor="@color/admin_orange_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_payment_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- REPORTS SECTION -->
        <LinearLayout
            android:id="@+id/section_reports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_detailed_report"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Open Detailed Performance Report (PKT &amp; Timers)"
                android:textColor="@color/admin_white"
                app:backgroundTint="@color/admin_orange"
                app:cornerRadius="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_reports_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:padding="16dp"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SETTINGS SECTION -->
        <LinearLayout
            android:id="@+id/section_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- LOGO UPLOADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restaurant Brand Logo (ImageKit)"
                android:textColor="@color/admin_orange_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_set_logo_preview"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_glass_card"
                    android:contentDescription="Restaurant Logo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_dera_emblem" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_set_logo_camera"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Cam"
                            android:textColor="@color/admin_white"
                            android:textSize="11.5sp"
                            app:backgroundTint="@color/admin_orange"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_set_logo_gallery"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:text="Photo"
                            android:textColor="@color/admin_orange_dark"
                            android:textSize="11.5sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/admin_orange" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_set_logo_remove"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Clear"
                            android:textColor="@color/admin_danger"
                            android:textSize="11.5sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/admin_danger" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pb_logo_upload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_logo_upload_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upload restaurant logo via Camera or Gallery"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Restaurant Name">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Restaurant Phone">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="WhatsApp Number (e.g. 923001112233)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_whatsapp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Restaurant Address">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="Opening Hours">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_set_open"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/admin_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Closing Hours">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_set_close"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/admin_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:hint="Delivery Charges (Rs)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_set_delivery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/admin_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Min Order (Rs)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_set_min_order"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/admin_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/admin_divider" />

            <!-- IMAGEKIT BACKEND CONFIG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ImageKit Upload Auth Config (No Private Key in App)"
                android:textColor="@color/admin_orange_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="ImageKit Public Key (public_...)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_imagekit_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="ImageKit Auth Server URL (https://.../api/imagekit)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_imagekit_endpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_settings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="Save Restaurant &amp; ImageKit Settings"
                android:textColor="@color/admin_white"
                app:backgroundTint="@color/admin_orange"
                app:cornerRadius="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/admin_divider" />

            <!-- BLACK COPPER BC-87AC PRINTER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card_orange"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Black Copper BC-87AC USB OTG Thermal Printer"
                    android:textColor="@color/admin_orange_dark"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_printer_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_printer_reconnect"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Scan / Reconnect"
                        android:textColor="@color/admin_orange_dark"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/admin_orange" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_printer_test"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Test Print 80mm"
                        android:textColor="@color/admin_white"
                        android:textSize="12sp"
                        app:backgroundTint="@color/admin_orange"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_seed_cloud_catalog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Sync Default Menu &amp; Online Images to Cloud"
                android:textColor="@color/admin_orange_dark"
                app:cornerRadius="12dp"
                app:strokeColor="@color/admin_orange" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/admin_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Authorized Admin UID"
                android:textColor="@color/admin_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Staff Firebase Auth UID">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_new_admin_uid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Staff Google Email">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_new_admin_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/admin_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_admin_uid"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="Authorize Admin Account"
                android:textColor="@color/admin_text_primary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/admin_yellow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_admin_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="Sign Out"
                android:textColor="@color/admin_white"
                app:backgroundTint="@color/admin_danger"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
